# Dashboard Configuration
NEXT_PUBLIC_STACK_DASHBOARD_URL=# https://dashboard.your-domain.com
NEXT_PUBLIC_STACK_API_URL=# https://api.your-domain.com

# Feature Flags
NEXT_PUBLIC_STACK_FEATURE_OAUTH_ENABLED=true
NEXT_PUBLIC_STACK_FEATURE_TEAMS_ENABLED=true

# Analytics Configuration
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_KEY=# your-analytics-key

# OAuth Configuration (if enabled)
NEXT_PUBLIC_OAUTH_GITHUB_CLIENT_ID=# your-github-client-id
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=# your-google-client-id
