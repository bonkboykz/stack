# Database Configuration
STACK_DATABASE_CONNECTION_STRING=# your-production-db-connection-string
STACK_DIRECT_DATABASE_CONNECTION_STRING=# your-production-direct-db-connection-string

# Server Configuration
STACK_SERVER_SECRET=# your-production-secret
NEXT_PUBLIC_STACK_API_URL=# https://api.your-domain.com

# Seed Configuration
STACK_SEED_INTERNAL_PROJECT_SIGN_UP_ENABLED=false
STACK_SEED_INTERNAL_PROJECT_OTP_ENABLED=true
STACK_SEED_INTERNAL_PROJECT_ALLOW_LOCALHOST=false
STACK_SEED_INTERNAL_PROJECT_OAUTH_PROVIDERS=# comma-separated-providers
STACK_SEED_INTERNAL_PROJECT_USER_EMAIL=# admin@your-domain.com
STACK_SEED_INTERNAL_PROJECT_USER_PASSWORD=# secure-password

# Email Configuration
STACK_EMAIL_HOST=# your-smtp-host
STACK_EMAIL_PORT=# your-smtp-port
STACK_EMAIL_USERNAME=# your-smtp-username
STACK_EMAIL_PASSWORD=# your-smtp-password
STACK_EMAIL_SENDER=# noreply@your-domain.com

# Webhook Configuration
STACK_SVIX_SERVER_URL=# your-svix-url
STACK_SVIX_API_KEY=# your-svix-key

# Migration and Seed Control
STACK_SKIP_MIGRATIONS=false
STACK_SKIP_SEED_SCRIPT=false
